  {"source": "hand:left.x", "target": "camera.pan.x", "op": "push", "value": 0.1},
  {"source": "hand:left.z", "target": "camera.pan.y", "op": "push", "value": 0.1},
  {"source": "hand:left.y", "target": "camera.zoom", "op": "push", "value": 0.12}
 ],
