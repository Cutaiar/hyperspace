{
  "schema": "hyperspace.loadable/11",
  "name": "field-knob",
  "note": "Any knob takes a field: Rings' distance from a Point, wired into Wave's Amount at a depth, so the wave is still at the Point and grows toward the edges. The sub band pumps the depth's base, the Amount; the right hand's height moves the Point across.",
  "graph": {
    "frame": "wired",
    "nodes": [
      {
        "kind": "hands",
        "laid": "over"
      },
      {
        "kind": "effect",
        "file": "point"
      },
      {
        "kind": "effect",
        "file": "rings"
      },
      {
        "kind": "effect",
        "file": "wave"
      }
    ],
    "wires": [
      {
        "from": "shape",
        "to": "scene.geometry"
      },
      {
        "from": "pattern",
        "to": "shape.faces"
      },
      {
        "from": "scene",
        "to": "wave.image"
      },
      {
        "from": "point",
        "to": "rings.field"
      },
      {
        "from": "rings",
        "to": "wave.amount",
        "depth": 0.06
      },
      {
        "from": "wave",
        "to": "output.all.image"
      },
      {
        "from": "hands",
        "to": "hands.layer.hands"
      },
      {
        "from": "hands.layer",
        "to": "output.all.hands"
      },
      {
        "from": "hands.layer",
        "to": "output.all.guide"
      }
    ]
  },
  "values": {
    "ghost.on": true,
    "ghost.alpha": 0.35,
    "view.shape": 55,
    "view.faces": true,
    "view.pattern": 2,
    "view.speed": 0.3,
    "view.bright": 1.35,
    "camera.zoom": 1.5,
    "fx.wave.on": true,
    "fx.wave.amount": 0.0,
    "fx.wave.waves": 4.0,
    "fx.wave.angle": 0.0,
    "fx.rings.on": true,
    "fx.rings.out": 0,
    "fx.point.on": true
  },
  "routes": [
    {
      "source": "lane:0",
      "target": "fx.wave.amount",
      "op": "push",
      "value": 0.2
    },
    {
      "source": "hand:right.y",
      "target": "fx.point.x",
      "op": "push",
      "value": 0.8
    },
    {
      "source": "lane:0",
      "target": "rot.rate.ZW",
      "op": "push",
      "value": 0.0625,
      "scale": "master.gain"
    },
    {
      "source": "lane:1",
      "target": "rot.rate.XW",
      "op": "push",
      "value": 0.0625,
      "scale": "master.gain"
    },
    {
      "source": "lane:2",
      "target": "rot.rate.YW",
      "op": "push",
      "value": -0.0625,
      "scale": "master.gain"
    },
    {
      "source": "lane:3",
      "target": "rot.rate.XY",
      "op": "push",
      "value": -0.0625,
      "scale": "master.gain"
    },
    {
      "source": "lane:4",
      "target": "rot.rate.XZ",
      "op": "push",
      "value": 0.0625,
      "scale": "master.gain"
    },
    {
      "source": "lane:5",
      "target": "rot.rate.YZ",
      "op": "push",
      "value": -0.0625,
      "scale": "master.gain"
    }
  ],
  "macros": {},
  "units": {
    "camera.pan": "world",
    "fx.depth": "taper"
  },
  "media": {
    "channels": {}
  }
}
